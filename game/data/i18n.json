 "safe.title": {
  "uz_latn": "Xavfsiz grafika rejimi",
  "uz_cyrl": "Хавфсиз графика режими",
  "ru": "Безопасный режим графики"
 },
 "safe.opengl": {
  "uz_latn": "Oldingi safar ilova yuklanishda qotib qoldi. Grafika OpenGL (moslik) rejimiga o‘tkazildi va sifat pasaytirildi. Sozlamalar → Grafika’da qaytarish mumkin.",
  "uz_cyrl": "Олдинги сафар илова юкланишда қотиб қолди. Графика OpenGL (мослик) режимига ўтказилди ва сифат пасайтирилди. Созламалар → Графика’да қайтариш мумкин.",
  "ru": "В прошлый раз приложение зависло при загрузке. Графика переключена на OpenGL (совместимость), качество снижено. Вернуть можно в Настройки → Графика."
 },
 "safe.low": {
  "uz_latn": "Oldingi safar ilova yuklanishda qotib qoldi. Grafika sifati eng past darajaga tushirildi. Muammo takrorlansa, jurnalni nusxalab ishlab chiquvchiga yuboring.",
  "uz_cyrl": "Олдинги сафар илова юкланишда қотиб қолди. Графика сифати энг паст даражага туширилди. Муаммо такрорланса, журнални нусхалаб ишлаб чиқувчига юборинг.",
  "ru": "В прошлый раз приложение зависло при загрузке. Качество графики снижено до минимума. Если повторится, скопируйте журнал и отправьте разработчику."
 },
 "safe.auto": {
  "uz_latn": "Yuklash vaqtida grafika drayveri javob bermay qoldi. O‘yin o‘zi OpenGL (moslik) rejimiga o‘tdi, sifatni pasaytirdi va qayta ishga tushdi. Sozlamalar → Grafika’da qaytarish mumkin.",
  "uz_cyrl": "Юклаш вақтида графика драйвери жавоб бермай қолди. Ўйин ўзи OpenGL (мослик) режимига ўтди, сифатни пасайтирди ва қайта ишга тушди. Созламалар → Графика’да қайтариш мумкин.",
  "ru": "Во время загрузки графический драйвер перестал отвечать. Игра сама переключилась на OpenGL (совместимость), снизила качество и перезапустилась. Вернуть можно в Настройки → Графика."
 },
