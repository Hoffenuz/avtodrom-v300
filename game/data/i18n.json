 "help.touch": {
  "uz_latn": "Chapda — rul, o‘ngda — gaz va tormoz pedallari (barmog‘ingizni pastroq qo‘ysangiz, pedal kuchliroq bosiladi). Yuqorida — burilish chiroqlari, avariya chirog‘i, kamar, kalit va qo‘l tormozi.",
  "uz_cyrl": "Чапда — рул, ўнгда — газ ва тормоз педаллари (бармоғингизни пастроқ қўйсангиз, педаль кучлироқ босилади). Юқорида — бурилиш чироқлари, авария чироғи, камар, калит ва қўл тормози.",
  "ru": "Слева — руль, справа — педали газа и тормоза (чем ниже палец, тем сильнее нажатие). Сверху — поворотники, аварийка, ремень, ключ и ручник."
 },
 "help.keyboard": {
  "uz_latn": "Klaviatura: W/S — gaz/tormoz, A/D — rul, C — debriyaj, 1–5/R/N — uzatmalar, Q/E — burilish chiroqlari, H — avariya, B — kamar, I — kalit (bosib turing — o‘t oldirish), Probel — qo‘l tormozi, V — kamera, Esc — pauza.",
  "uz_cyrl": "Клавиатура: W/S — газ/тормоз, A/D — рул, C — дебриаж, 1–5/R/N — узатмалар, Q/E — бурилиш чироқлари, H — авария, B — камар, I — калит (босиб туринг — ўт олдириш), Пробел — қўл тормози, V — камера, Esc — пауза.",
  "ru": "Клавиатура: W/S — газ/тормоз, A/D — руль, C — сцепление, 1–5/R/N — передачи, Q/E — поворотники, H — аварийка, B — ремень, I — ключ (удерживать — запуск), Пробел — ручник, V — камера, Esc — пауза."
 },
 "help.auto": {
  "uz_latn": "Avtomat (Cobalt): P/R/N/G tugmalari yoki ekrandagi selektor; P va R ga faqat to‘xtab turganda o‘tiladi.",
  "uz_cyrl": "Автомат (Cobalt): P/R/N/G тугмалари ёки экрандаги селектор; P ва R га фақат тўхтаб турганда ўтилади.",
  "ru": "Автомат (Cobalt): клавиши P/R/N/G или экранный селектор; P и R — только на месте."
 }
