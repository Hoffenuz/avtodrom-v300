; Engine configuration file.
; AvtoSmart Avtodrom — Toshkent imtihon markazi avtodromi simulyatori.

config_version=5

[application]

config/name="AvtoSmart Avtodrom"
; Keep the data folder of the versions called "Avtodrom" (settings, exam history).
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Avtodrom"
config/description="AvtoSmart Avtodrom — haydovchilik amaliy imtihoni simulyatori"
config/version="1.0.8"
; Written by the game (Settings -> Graphics mode, or after a load that hung):
; switches the renderer to OpenGL on the next start, on every platform.
config/project_settings_override="user://graphics_override.cfg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/ui/icon_round.png"
; Windows: the window / taskbar icon (the round mark, simplified at 16-32 px).
config/windows_native_icon="res://assets/ui/icon_windows.ico"
boot_splash/bg_color=Color(0.05, 0.2, 0.12, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/stretch_mode=3
run/low_processor_mode=false
run/flush_stdout_on_print=true
config/quit_on_go_back=false

[audio]
general/default_playback_type.web=0
driver/output_latency.web=100

driver/mix_rate=32000

[autoload]

Settings="*res://src/autoload/settings.gd"
Loc="*res://src/autoload/loc.gd"
Loading="*res://src/autoload/loading_screen.gd"
Session="*res://src/autoload/session.gd"
DebugShots="*res://src/autoload/debug_shots.gd"

[debug]

; Logs on every platform (user://logs/godot.log), flushed line by line: a
; device that hangs still leaves a log to send (Settings -> About copies it).
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/max_log_files=8

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/size/mode.web=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[gui]

common/snap_controls_to_pixels=true
theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.80665

[rendering]
shading/overrides/force_vertex_shading.web=true
limits/opengl/max_renderable_lights.web=2
limits/opengl/max_lights_per_object.web=2

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)
